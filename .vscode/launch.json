    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug TTSRS",
            "cargo": {
                "args": ["build", "-j4"],
                "filter": {
                    "name": "ttsrs",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Release TTSRS",
            "cargo": {
                "args": ["build", "--release", "-j4"],
                "filter": {
                    "name": "ttsrs",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}